include README.md
include .env.example
recursive-include docs *.md
recursive-include examples *.toml *.py
recursive-include src/biometry_parser/schemas *.json
include src/biometry_parser/model_manifest.json
global-exclude *.pdf *.onnx *.pyc *.pyo
exclude .env g-api.txt p-api.txt
prune .cache
prune .venv
prune outputs
prune tests/private
