          "type": "string"
        },
        "formula": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Formula"
        },
        "keratometry_source": {
          "default": "unknown",
          "enum": [
            "K",
            "TK",
            "unknown"
          ],
          "title": "Keratometry Source",
          "type": "string"
        },
        "target_refraction": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Refraction"
        },
        "constants": {
          "items": {
            "$ref": "#/$defs/IOLConstantClaim"
          },
          "title": "Constants",
          "type": "array"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/IOLRow"
          },
          "title": "Rows",
          "type": "array"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/Box"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "raw_text": {
          "default": "",
          "title": "Raw Text",
          "type": "string"
        },
        "provider_id": {
          "default": "",
          "title": "Provider Id",
          "type": "string"
        },
        "profile_id": {
          "default": "",
          "title": "Profile Id",
          "type": "string"
        },
        "model_id": {
          "default": "",
          "title": "Model Id",
          "type": "string"
        },
        "model_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Hash"
        },
        "family": {
          "default": "",
          "title": "Family",
          "type": "string"
        },
        "flags": {
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "verification_status": {
          "default": "unverified",
          "enum": [
            "unverified",
            "cross_checked"
          ],
          "title": "Verification Status",
          "type": "string"
        }
      },
      "required": [
        "table_id",
        "page_number"
      ],
      "title": "IOLCalculation",
      "type": "object"
    },
    "IOLConstantClaim": {
      "additionalProperties": false,
