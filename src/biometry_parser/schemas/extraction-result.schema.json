{
  "$defs": {
    "Box": {
      "additionalProperties": false,
      "description": "Normalized coordinates on the displayed original page, top-left origin.",
      "properties": {
        "x0": {
          "maximum": 1,
          "minimum": 0,
          "title": "X0",
          "type": "number"
        },
        "y0": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y0",
          "type": "number"
        },
        "x1": {
          "maximum": 1,
          "minimum": 0,
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y1",
          "type": "number"
        }
      },
      "required": [
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "title": "Box",
      "type": "object"
    },
    "DataStatus": {
      "description": "Source facts, independent of execution success and verification.",
      "enum": [
        "present",
        "not_found",
        "absent",
        "blank",
        "not_measured",
        "unreadable",
        "conflict"
      ],
      "title": "DataStatus",
      "type": "string"
    },
    "EyeResult": {
      "additionalProperties": false,
      "properties": {
        "al": {
          "$ref": "#/$defs/FieldResult"
        },
        "acd": {
          "$ref": "#/$defs/FieldResult"
        },
        "lt": {
          "$ref": "#/$defs/FieldResult"
        },
        "cct": {
          "$ref": "#/$defs/FieldResult"
        },
        "wtw": {
          "$ref": "#/$defs/FieldResult"
        },
        "mean_k": {
          "$ref": "#/$defs/FieldResult"
        },
        "corneal_astigmatism": {
          "$ref": "#/$defs/FieldResult"
        },
        "corneal_astigmatism_axis": {
          "$ref": "#/$defs/FieldResult"
        },
        "pupil": {
          "$ref": "#/$defs/FieldResult"
        },
        "k1": {
          "$ref": "#/$defs/Keratometry"
        },
        "k2": {
          "$ref": "#/$defs/Keratometry"
        },
        "tk1": {
          "$ref": "#/$defs/Keratometry"
        },
        "tk2": {
          "$ref": "#/$defs/Keratometry"
        }
      },
      "title": "EyeResult",
      "type": "object"
    },
    "FieldResult": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "status": {
          "$ref": "#/$defs/Status",
          "default": "not_reported"
        },
        "data_status": {
          "$ref": "#/$defs/DataStatus",
          "default": "not_found"
        },
        "candidate_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Candidate Value"
        },
        "verification_status": {
          "default": "unverified",
          "enum": [
            "unverified",
            "cross_checked"
          ],
          "title": "Verification Status",
          "type": "string"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "title": "Candidates",
          "type": "array"
        }
      },
      "title": "FieldResult",
      "type": "object"
    },
    "IOLCalculation": {
      "additionalProperties": false,
      "description": "Unverified table-level source evidence, separate from biometric values.",
