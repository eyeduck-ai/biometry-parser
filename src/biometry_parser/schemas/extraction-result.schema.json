        "table_id": {
          "title": "Table Id",
          "type": "string"
        },
        "eye": {
          "anyOf": [
            {
              "enum": [
                "OD",
                "OS"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eye"
        },
        "lens_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
